# This is the configuration file for Ghostty.
# Run `ghostty +show-config --default --docs` to view available options.

# ========================================
# テーマ設定
# ========================================

#theme = light:Catppuccin Latte,dark:Catppuccin Mocha
theme = Catppuccin Mocha
background-opacity = 0.92
{{- if eq .chezmoi.os "darwin" }}
background-blur-radius = 15
{{- end }}
#font-family = "CaskaydiaCove Nerd Font Mono"
#font-family = "Maple Mono"
font-family = "Maple Mono NF CN"
font-style = "Heavy"
font-size = 15

#background-image = "~/Pictures/oberon.jpg"
#background-image-opacity = 0.2
#background-image-fit = stretch

# ========================================
# ウィンドウ設定
# ========================================

#window-padding-x = 10
#window-padding-y = 4
window-padding-balance = true
window-theme = ghostty

# ウィンドウ状態を保存
window-save-state = always

# 画面分割したときにpathが引き継がれる
window-inherit-working-directory = true

{{- if eq .chezmoi.os "darwin" }}
# タイトルバーを非表示にする
macos-titlebar-style = tabs
{{- end }}

{{- if eq .chezmoi.os "darwin" }}
# ========================================
# クイックターミナルの有効化
# ========================================
quick-terminal-position = "left"
quick-terminal-screen = "main"
quick-terminal-size = 45%
quick-terminal-animation-duration = 0.3
keybind = "global:shift+alt+space=toggle_quick_terminal"
{{- end }}

# 非アクティブなウインドウを薄くしない
unfocused-split-opacity = 0.7

# ========================================
# パフォーマンス設定
# ========================================

# スクロールバック行数（大量出力に対応）
scrollback-limit = 100000

# マウス関連
mouse-hide-while-typing = true
mouse-scroll-multiplier = 2

# ========================================
# シェル統合
# ========================================

# シェル統合を有効化
shell-integration = detect
shell-integration-features = cursor,sudo,title

# ========================================
# キーバインド
# ========================================

{{- if eq .chezmoi.os "darwin" }}
# 設定リロード
keybind = cmd+shift+comma=reload_config

# split
keybind = cmd+w=close_surface

# スプリット間移動（Vim風）
keybind = ctrl+cmd+h=goto_split:left
keybind = ctrl+cmd+j=goto_split:bottom
keybind = ctrl+cmd+k=goto_split:top
keybind = ctrl+cmd+l=goto_split:right

# プロンプト間ジャンプ（Claude Codeの出力を素早く確認）
keybind = cmd+up=jump_to_prompt:-1
keybind = cmd+down=jump_to_prompt:1
{{- else }}
# 設定リロード
keybind = ctrl+shift+comma=reload_config

# split
keybind = ctrl+shift+w=close_surface

# スプリット間移動（Vim風）
keybind = ctrl+alt+h=goto_split:left
keybind = ctrl+alt+j=goto_split:bottom
keybind = ctrl+alt+k=goto_split:top
keybind = ctrl+alt+l=goto_split:right

# プロンプト間ジャンプ
keybind = ctrl+up=jump_to_prompt:-1
keybind = ctrl+down=jump_to_prompt:1
{{- end }}

# shift+enterを改行扱いする（v2）
#keybind = shift+enter=text:\x1b\r
keybind = shift+enter=text:\n

# ========================================
# その他の設定
# ========================================

# 通知
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 2s

# リンクのプレビュー
link-previews = true

{{- if eq .chezmoi.os "darwin" }}
# アイコンの変更
macos-icon = xray
{{- end }}
