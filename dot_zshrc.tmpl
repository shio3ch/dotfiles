[ -r /etc/zshrc ] && . /etc/zshrc

# -------------------------------------------------------------
# Completion
autoload -U compinit && compinit

# -------------------------------------------------------------
# Load secrets (API keys, tokens, etc.)
for file in ~/.secrets/*.sh(N); do
  source "$file"
done

# Load hooks (brew wrapper, etc.)
for file in ~/.zsh/hooks/*.zsh(N); do
  source "$file"
done

{{- if eq .chezmoi.os "darwin" }}
# coreutils
# mac標準のBSDコマンドを coreutils の GNUコマンドに置き換える
export PATH="/opt/homebrew/opt/coreutils/libexec/gnubin:$PATH"
{{- end }}

# nodebrew (macOS)
if [ -d "$HOME/.nodebrew/current/bin" ]; then
  export PATH="$HOME/.nodebrew/current/bin:$PATH"
fi

# -------------------------------------------------------------
# starship
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

# zoxide
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

# -------------------------------------------------------------
# eza を ls の代わりに使う
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --icons'
  alias ll='eza -l --icons'
  alias la='eza -la --icons'
  alias al='eza -la --icons'
else
  alias ll='ls -l'
  alias la='ls -la'
  alias al='ls -la'
fi

# vim を nvim に置き換える
if command -v nvim >/dev/null 2>&1; then
  alias vim='nvim'
fi

# bat を cat の代わりに使う
if command -v bat >/dev/null 2>&1; then
  alias cat='bat --paging=never'
elif command -v batcat >/dev/null 2>&1; then
  alias cat='batcat --paging=never'
fi

# lazygit
if command -v lazygit >/dev/null 2>&1; then
  alias lgit='lazygit'
fi

# chezmoi
if command -v chezmoi >/dev/null 2>&1; then
  alias cdiff='chezmoi diff'
  alias capply='chezmoi apply'
  alias cupdate='chezmoi update'
fi

# pnpm
{{- if eq .chezmoi.os "darwin" }}
export PNPM_HOME="$HOME/Library/pnpm"
{{- else }}
export PNPM_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/pnpm"
{{- end }}
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# Antigravity
if [ -d "$HOME/.antigravity/antigravity/bin" ]; then
  export PATH="$HOME/.antigravity/antigravity/bin:$PATH"
fi

# user local bin
export PATH="$HOME/.local/bin:$PATH"
